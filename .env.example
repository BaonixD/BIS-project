# Copy to .env and adjust locally. Never commit .env or real secrets.

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Required by the application and Alembic. SQLite file relative to the current directory.
# Tests use their own temporary database files, never this one.
DATABASE_URL=sqlite+aiosqlite:///./taxi.db

# Session cookie Secure flag. The default (true) is for HTTPS; local development over
# plain http://localhost needs false, otherwise the browser never sends the cookie back.
SESSION_COOKIE_SECURE=false

# Browser origins allowed for credentialed CORS and for login/register requests that
# carry an Origin header. Comma-separated, no wildcard. Example: a local React dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Sign-in with Google for passengers: OAuth client ID of type "Web application" from
# Google Cloud Console (see README). Not a secret, but keep the real value in the local .env.
# Empty: Google sign-in is off and POST /api/v1/auth/google answers 503 google_login_unavailable.
GOOGLE_CLIENT_ID=

# Owner-provided Kaspi payment link (host pay.kaspi.kz). Keep the real link only in the local .env, never in Git.
KASPI_PAYMENT_URL=

# Road routing provider: osrm (local server, ADR 0014) or openrouteservice (ADR 0002).
ROUTING_PROVIDER=osrm
# Local OSRM server (infra/osrm/docker-compose.yml). Empty, or the container is not running:
# POST /api/v1/geo/route and quotes answer 503 routing_unavailable.
OSRM_BASE_URL=http://127.0.0.1:5001

# openrouteservice only: personal free key, only in the local .env (keep empty here).
# Without it the API still starts and POST /api/v1/geo/route answers 503 routing_unavailable.
ROUTING_API_KEY=

# Optional routing limits; the commented values are the defaults.
# ROUTING_BASE_URL=https://api.openrouteservice.org
# ROUTING_CONNECT_TIMEOUT_S=3.0
# ROUTING_READ_TIMEOUT_S=5.0
# Retries apply only to timeouts, connection errors, 429 and 5xx (at most 5).
# ROUTING_MAX_RETRIES=1
# ROUTING_RETRY_BACKOFF_S=0.5
# ROUTING_MAX_RETRY_DELAY_S=5.0
# Whole budget of one route request, all attempts and pauses included.
# ROUTING_TOTAL_TIMEOUT_S=10.0

# Пароль демо-аккаунтов для scripts/seed.py (10–128 символов); только в локальном .env.
DEMO_PASSWORD=

# Driver dispatch; the commented values are the defaults (MVP_SPEC §6).
# OFFER_TTL_S=30
# SEARCH_BUDGET_S=180
# DISPATCH_INTERVAL_S=1.0
# DISPATCH_LOOP_ENABLED=true
