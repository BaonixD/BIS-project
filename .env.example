# Copy to .env and adjust locally. Never commit .env or real secrets.

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# Local SQLite file relative to the project root. Read by the application from T01.
# Tests use their own temporary database files, never this one.
DATABASE_URL=sqlite+aiosqlite:///./taxi.db

# Owner-provided Kaspi payment link (host pay.kaspi.kz). Used from T08; keep empty here.
KASPI_PAYMENT_URL=

# Road routing provider API key. Used from T04; keep empty here.
ROUTING_API_KEY=
